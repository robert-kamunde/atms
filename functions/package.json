{
  "name": "atms-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:unit": "jest --selectProjects unit",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-atms \"jest --selectProjects rules --runInBand\"",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-atms \"jest --selectProjects integration --runInBand\"",
    "bootstrap-org": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bootstrap-org.ts",
    "test": "npm run test:unit && npm run test:rules && npm run test:integration"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "firebase": "^12.19.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
}
