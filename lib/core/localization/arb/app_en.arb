  "consentIntro": "Before you start, please read how ATMS uses your personal data. This notice follows the Tanzania Personal Data Protection Act, 2022.",
  "@consentIntro": {
    "description": "Consent intro. Legal text: client must review. SW_REVIEW: Kiswahili needs native-speaker check."
  },
  "consentRetentionBody": "Task records and the audit log are kept for at least 3 years, or as your organisation decides, for accountability.",
  "@consentRetentionBody": {
    "description": "Consent: retention. SW_REVIEW: Kiswahili needs native-speaker check."
  },
  "consentRetentionTitle": "How long we keep it",
  "@consentRetentionTitle": {
    "description": "Consent section title."
  },
  "consentRightsBody": "You can ask your organisation's administrator to see or correct your personal data, or to stop using it where the law allows. You can also complain to the Personal Data Protection Commission.",
  "@consentRightsBody": {
    "description": "Consent: data subject rights. SW_REVIEW: Kiswahili needs native-speaker check."
  },
  "consentRightsTitle": "Your rights",
  "@consentRightsTitle": {
    "description": "Consent section title."
  },
  "consentSecurityBody": "Your data is encrypted while it travels over the internet and while it is stored on the servers. Access is checked on the server for every request. A copy is also kept on your phone so you can work offline.",
  "@consentSecurityBody": {
    "description": "Consent: security. Must NOT claim end-to-end encryption. SW_REVIEW: Kiswahili needs native-speaker check."
  },
  "consentSecurityTitle": "How it is protected",
